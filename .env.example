PORT=3000
APP_ORIGIN=http://localhost:5173
MONGO_URI=mongodb://127.0.0.1:27017/interviewforge
# Generate a random value with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Google OAuth web application credentials. Register APP_ORIGIN + /api/v1/auth/google/callback.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Resend API key and an email address on a verified sending domain.
RESEND_API_KEY=
PASSWORD_RESET_FROM=
# local uses curated questions and limited rule-based coaching.
# Select openai, gemini or ollama for LangChain-backed practice.
AI_PROVIDER=local
AI_MODEL=
OPENAI_API_KEY=
# Optional fallback when the browser cannot finish a recording transcript.
# AUDIO_TRANSCRIPTION_MODEL=gpt-transcribe
GOOGLE_API_KEY=
OLLAMA_URL=http://127.0.0.1:11434
AI_TIMEOUT_MS=12000
SECURE_COOKIES=false
TRUST_PROXY=0
